---
interface Props {
  title: string;
  description: string;
  icon?: string;
}

const { title, description, icon = "◆" } = Astro.props;
---

<div class="card-flat p-6 lg:p-7 flex flex-col gap-4">
  <div
    class="text-xl w-10 h-10 flex items-center justify-center rounded-lg"
    style="background-color: #f8e8ee; color: #7b1e3a;"
    aria-hidden="true"
  >
    {icon}
  </div>
  <div>
    <h3 class="font-serif text-[1.0625rem] font-semibold mb-2" style="color: #18181b;">
      {title}
    </h3>
    <p class="text-[0.8125rem] leading-relaxed" style="color: #52525b;">
      {description}
    </p>
  </div>
</div>
