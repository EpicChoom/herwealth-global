---
interface Props {
  title: string;
  shortDescription: string;
  slug: string;
  ctaLabel?: string;
  ctaHref?: string;
  icon?: string;
}

const {
  title,
  shortDescription,
  slug,
  ctaLabel = "Explore Track",
  ctaHref,
  icon,
} = Astro.props;

const trackIcons: Record<string, string> = {
  "investing-financial-literacy": "📈",
  entrepreneurship: "💡",
  "leadership-confidence": "🌟",
};

const displayIcon = icon ?? trackIcons[slug] ?? "◆";
const href = ctaHref ?? `/academy#${slug}`;
---

<div class="card p-7 lg:p-8 flex flex-col h-full">
  <!-- Icon -->
  <div
    class="text-2xl w-12 h-12 flex items-center justify-center rounded-xl mb-5"
    style="background-color: #f8e8ee;"
    aria-hidden="true"
  >
    {displayIcon}
  </div>

  <!-- Title -->
  <h3 class="font-serif text-xl font-semibold mb-3 leading-snug" style="color: #18181b;">
    {title}
  </h3>

  <!-- Description -->
  <p class="text-[0.8125rem] leading-relaxed flex-1 mb-6" style="color: #52525b;">
    {shortDescription}
  </p>

  <!-- CTA link -->
  <a
    href={href}
    class="inline-flex items-center gap-1.5 text-sm font-semibold group"
    style="color: #7b1e3a;"
  >
    {ctaLabel}
    <span class="transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">→</span>
  </a>
</div>
