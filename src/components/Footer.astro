---
import { siteConfig } from "../data/site";
import { footerNavigation } from "../data/navigation";

const currentYear = new Date().getFullYear();
---

<footer style="background-color: #18181b;">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 pt-16 pb-10 lg:pt-20 lg:pb-12">

    <!-- Top section: brand + columns -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16 pb-12 border-b" style="border-color: #27272a;">

      <!-- Brand column -->
      <div class="md:col-span-5">
        <a href="/" class="inline-flex items-center gap-2.5 mb-5" aria-label={`${siteConfig.name} — Home`}>
          <img
            src="/logo.jpg"
            alt={`${siteConfig.name} logo`}
            class="h-10 w-10 rounded-full object-cover ring-1"
            style="--tw-ring-color: #3f3f46;"
            width="40"
            height="40"
          />
          <span class="font-serif font-semibold text-lg text-white">
            {siteConfig.name}
          </span>
        </a>
        <p class="text-sm leading-relaxed max-w-sm" style="color: #a1a1aa;">
          Empowering young women to lead boldly, think globally, and build
          confidence through financial literacy, entrepreneurship, leadership
          development, and community.
        </p>
        <p class="mt-5 text-sm font-medium italic" style="color: #c9a227;">
          {siteConfig.secondarySlogan}
        </p>
      </div>

      <!-- Navigation column -->
      <div class="md:col-span-3">
        <h3 class="text-xs font-semibold uppercase tracking-widest mb-5" style="color: #71717a;">
          Navigate
        </h3>
        <nav aria-label="Footer navigation">
          <ul class="space-y-2.5">
            {
              footerNavigation.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="text-sm transition-colors duration-150 hover:text-white"
                    style="color: #a1a1aa;"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <!-- Connect column -->
      <div class="md:col-span-4">
        <h3 class="text-xs font-semibold uppercase tracking-widest mb-5" style="color: #71717a;">
          Connect
        </h3>
        <ul class="space-y-3.5">
          <li>
            <a
              href={siteConfig.joinFormUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 text-sm font-semibold transition-colors duration-150 hover:text-white"
              style="color: #f8e8ee;"
            >
              <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
              Join HerWealth Global
            </a>
          </li>
          <li>
            <a
              href={siteConfig.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 text-sm transition-colors duration-150 hover:text-white"
              style="color: #a1a1aa;"
            >
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
              </svg>
              @herwealthglobal.official
            </a>
          </li>
          <li>
            <span class="inline-flex items-center gap-2.5 text-sm" style="color: #52525b;">
              <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
              <span class="italic">Email coming soon</span>
            </span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom: disclaimer + copyright -->
    <div class="pt-8">
      <p class="text-xs leading-relaxed mb-5 max-w-3xl" style="color: #52525b;">
        <strong class="font-medium" style="color: #71717a;">Disclaimer:</strong>{" "}
        {siteConfig.investingDisclaimer}
      </p>
      <p class="text-xs" style="color: #3f3f46;">
        &copy; {currentYear} {siteConfig.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
