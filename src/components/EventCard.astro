---
interface Props {
  title: string;
  date: string;
  time?: string;
  location?: string;
  category: string;
  description: string;
  registrationUrl?: string;
  skillLevel?: string;
  status?: string;
  featured?: boolean;
}

const {
  title,
  date,
  time,
  location,
  category,
  description,
  registrationUrl,
  skillLevel,
  status = "coming-soon",
  featured = false,
} = Astro.props;

const isComingSoon = status === "coming-soon" || date === "TBD";

const categoryColors: Record<string, string> = {
  Workshop: "background-color: #f8e8ee; color: #7b1e3a;",
  Entrepreneurship: "background-color: #efe1b4; color: #6b4f00;",
  Training: "background-color: #f4f4f5; color: #52525b;",
  default: "background-color: #f4f4f5; color: #52525b;",
};

const categoryStyle = categoryColors[category] ?? categoryColors.default;
---

<article
  class={`card overflow-hidden flex flex-col h-full ${featured ? "ring-1" : ""}`}
  style={featured ? "ring-color: #7b1e3a;" : ""}
>
  <!-- Header bar -->
  <div class="px-6 pt-6 pb-0 flex items-center justify-between gap-3">
    <span
      class="inline-block text-[0.6875rem] font-semibold uppercase tracking-wide px-2.5 py-1 rounded-md"
      style={categoryStyle}
    >
      {category}
    </span>
    {
      isComingSoon && (
        <span
          class="text-[0.6875rem] font-medium px-2 py-0.5 rounded-md"
          style="background-color: #f7f1ea; color: #8b6914;"
        >
          Coming Soon
        </span>
      )
    }
  </div>

  <!-- Content -->
  <div class="p-6 flex flex-col flex-1">
    <h3 class="font-serif text-lg font-semibold mb-2.5 leading-snug" style="color: #18181b;">
      {title}
    </h3>

    <!-- Meta -->
    <div class="flex flex-wrap gap-x-3 gap-y-1 mb-3 text-[0.8125rem]" style="color: #71717a;">
      <span class="inline-flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
        {isComingSoon ? "Date TBD" : date}
      </span>
      {
        location && location !== "TBD" ? (
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
            {location}
          </span>
        ) : (
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
            Location TBD
          </span>
        )
      }
    </div>

    {skillLevel && (
      <p class="text-xs font-medium mb-3" style="color: #7b1e3a;">
        {skillLevel}
      </p>
    )}

    <p class="text-[0.8125rem] leading-relaxed flex-1 mb-5" style="color: #52525b;">
      {description}
    </p>

    <!-- CTA -->
    {
      registrationUrl ? (
        <a
          href={registrationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm font-semibold group"
          style="color: #7b1e3a;"
        >
          {isComingSoon ? "Get Notified" : "Register Now"}
          <span class="transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">→</span>
        </a>
      ) : (
        <span class="text-sm" style="color: #a1a1aa;">
          Registration details coming soon
        </span>
      )
    }
  </div>
</article>
