---
interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  centered?: boolean;
  light?: boolean;
}

const { title, subtitle, eyebrow, centered = true, light = false } = Astro.props;
---

<div class={`mb-14 lg:mb-16 ${centered ? "text-center" : ""}`}>
  {
    eyebrow && (
      <p
        class={`text-xs font-semibold uppercase tracking-[0.15em] mb-4 ${centered ? "" : ""}`}
        style={light ? "color: #c9a227;" : "color: #7b1e3a;"}
      >
        {eyebrow}
      </p>
    )
  }
  <h2
    class="font-serif text-3xl sm:text-[2.25rem] lg:text-4xl font-semibold leading-tight mb-5"
    style={light ? "color: white;" : "color: #18181b;"}
  >
    {title}
  </h2>
  {
    subtitle && (
      <p
        class={`text-base lg:text-[1.0625rem] leading-relaxed max-w-2xl ${centered ? "mx-auto" : ""}`}
        style={light ? "color: rgba(255,255,255,0.8);" : "color: #52525b;"}
      >
        {subtitle}
      </p>
    )
  }
</div>
